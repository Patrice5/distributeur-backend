# ========================================
# CONFIGURATION DISTRIBUTEUR ESI
# Copiez ce fichier en .env et modifiez les valeurs
# ========================================

# Environnement (development ou production)
FLASK_ENV=development

# Mode debug
FLASK_DEBUG=True

# Base de données
DATABASE_NAME=distributeur.db

# Serveur
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Clé secrète (générer une vraie clé aléatoire en production)
SECRET_KEY=dev-secret-key-change-in-production

# Seuils d'alerte
SEUIL_NIVEAU_BAS=20
SEUIL_TEMPERATURE_HAUTE=15.0
TIMEOUT_MACHINE=5

# CORS (en production, spécifier les domaines exacts)
CORS_ORIGINS=*